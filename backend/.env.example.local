# APP NAME
APP_NAME=Web app starter
# PORT
PORT=3001
# Base prefix to be added to all end-points
BASE_URL_PREFIX=/api
# ENVIRONMENT=LOCAL stänger av Secure-flaggan på sessionskakan för lokal http
# (yarn dev + lokala prod-byggen). Använd TEST i testmiljön och lämna den
# tom/osatt i produktion.
ENVIRONMENT=LOCAL
# Sessionskakans path. Ska vara appens monteringsrot, inte API-prefixet, så att kakan
# är synlig både för frontend (basePath) och API:et. Exempel i testmiljön:
# BASE_URL_PREFIX=/registrering/avvikelse_iaf/api -> SESSION_COOKIE_PATH=/registrering/avvikelse_iaf
# Lämnas den tom används BASE_URL_PREFIX (gamla beteendet).
SESSION_COOKIE_PATH=/
# Unikt kaknamn per app så att appar som delar värdnamn inte kan förväxla varandras
# sessioner. Måste matcha NEXT_PUBLIC_SESSION_COOKIE_NAME i frontend.
# Lämnas den tom används connect.sid.
SESSION_COOKIE_NAME=connect.sid
# Sundsvalls kommun API end-point
API_BASE_URL=https://api-test.sundsvall.se
# Credentials used for API
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# SAML
# Backend URLs - full URLS
SAML_CALLBACK_URL=http://localhost:3001/api/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/api/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/api/saml/login

# Fallback if provided URL is invalid.
SAML_SUCCESS_REDIRECT=http://localhost:3000

SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY=
SAML_PUBLIC_KEY=

# Groups that are allowed to login
AUTHORIZED_GROUPS="group1,group2"

# Unik sessionshemlighet. Generera 32 slumpbyte enligt README; mallen ska inte kunna användas direkt.
SECRET_KEY=

# Swagger
SWAGGER_ENABLED=true

# LOG - for prod use "combined" LOG_FORMAT
LOG_FORMAT=dev
LOG_DIR=../../data/logs

# CORS AND REDIRECT
ORIGIN=http://localhost:3000,http://localhost:3002

MUNICIPALITY_ID=
NAMESPACE=

CREDENTIALS=true
