# Copy to a protected file outside Git. Relative KATLA_CATALOGUE_FILE resolves from this file's directory in the CLI.
APP_MODE=katla
KATLA_ID=avvikelse
KATLA_CATALOGUE_FILE=./catalogue.json
SESSION_COOKIE_NAME=katla.avvikelse.sid
SESSION_COOKIE_PATH=/
NEXT_PUBLIC_SESSION_COOKIE_NAME=katla.avvikelse.sid
NEXT_PUBLIC_API_URL=https://avvikelse.example.invalid/api
NEXT_PUBLIC_CATALOGUE_URL=https://katla.example.invalid
NEXT_PUBLIC_BASE_PATH=
DOMAIN_NAME=avvikelse.example.invalid
BASE_URL_PREFIX=/api
ORIGIN=https://avvikelse.example.invalid
# Add actual API_BASE_URL, CLIENT_KEY, CLIENT_SECRET, MUNICIPALITY_ID, NAMESPACE,
# SECRET_KEY, SAML_* and operational settings from backend/.env.example.local.
# For catalogue: APP_MODE=catalogue, omit KATLA_ID, use katla.catalogue.sid,
# use the catalogue's own URLs, and omit all errand API credentials and namespace.
