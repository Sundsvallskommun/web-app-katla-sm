# =============================================================================
# Root-.env för `docker compose up -d --build`
# Kopiera till .env. Läses automatiskt av Docker Compose.
#
# Den här filen innehåller ENDAST det som Compose interpolerar (${...}):
# containernamn och portpublicering. Applikationernas egna variabler bor i
# sina respektive paket - se längst ner.
# =============================================================================

# --- Compose: containernamn -------------------------------------------------
COMPOSE_PROJECT_NAME=katla-sm
NODE_ENV=production

# --- Compose: portpublicering -----------------------------------------------
# Adress som portarna publiceras på. 127.0.0.1 = endast hosten (HAProxy) når
# containrarna. Sätt till 0.0.0.0 endast om något utanför hosten ska nå dem.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=3001

# --- Guard för frontend-bygget ----------------------------------------------
# Gör inget i runtime (se docker-compose.override.yml) men måste vara satt.
# Ska vara identisk med NEXT_PUBLIC_API_URL i frontend/.env.local.
NEXT_PUBLIC_API_URL=https://katla.sundsvall.se/api

# =============================================================================
# BACKEND - backend/.env.production.local
# -----------------------------------------------------------------------------
# Skickas in i containern via `env_file` i docker-compose.override.yml och
# ligger i backend/.dockerignore, så hemligheterna bakas inte in i imagen.
# Utgå från backend/.env.example.local och sätt skarpa värden för:
#
#   BASE_URL_PREFIX=/api
#   API_BASE_URL=https://api.sundsvall.se
#   CLIENT_KEY / CLIENT_SECRET          (WSO2)
#   SAML_*                              (publika URL:er, inte containerportar)
#   SECRET_KEY                          (unik per miljö, `openssl rand -hex 32`)
#   ORIGIN=https://katla.sundsvall.se   (CORS - frontendens publika origin)
#   SWAGGER_ENABLED=false
#   LOG_FORMAT=combined
#
# Utelämna PORT - den pinnas till 3000 i docker-compose.override.yml så att
# den inte kan gå isär med portmappningen.
#
# =============================================================================
# FRONTEND - frontend/.env.local
# -----------------------------------------------------------------------------
# Läses vid BUILD, inte i runtime. frontend/Dockerfile kör `COPY . .` och sedan
# `yarn build`; filen ligger inte i frontend/.dockerignore och följer med in i
# bygget. Både next build och middleware-envs-generator.mjs läser kaskaden
# .env.local -> .env, där .env.local vinner.
#
# next.config.js validerar NEXT_PUBLIC_API_URL, HEALTH_AUTH, HEALTH_USERNAME
# och HEALTH_PASSWORD med envalid - saknas de failar bygget. Värdena bakas
# dessutom in i middleware-envs.js som src/proxy.ts använder för route-skyddet;
# tomma värden gör att inga routes skyddas.
#
#   NEXT_PUBLIC_API_URL=https://katla.sundsvall.se/api
#   NEXT_PUBLIC_PROTECTED_ROUTES=...
#   HEALTH_AUTH=false
#   HEALTH_USERNAME=''
#   HEALTH_PASSWORD=''
#   DOMAIN_NAME=katla.sundsvall.se
#   NEXT_PUBLIC_BASE_PATH=''
# =============================================================================
